# KrishiKavach Backend Environment Variables
PROJECT_NAME="KrishiKavach Backend"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration
DATABASE_URL="sqlite:///./krishikavach.db"

# Open-Meteo API (Free tier, no key required)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# Agmarknet / APMC Market Data (Optional API Key)
AGMARKNET_API_KEY=""

# Gemini LLM Translation Key (Optional - Fallback template translation used if empty)
GEMINI_API_KEY=""

# Arbitration Threshold Constants (Centralized Defaults)
RAIN_IRRIGATION_SUPPRESS_MM_36H=25.0
WIND_SAFE_LIMIT_KMH=15.0
RAIN_PROB_SPRAY_BLOCK_PCT_6H=70.0
